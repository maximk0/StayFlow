# Required only with SPRING_PROFILES_ACTIVE=demo
DEMO_ADMIN_PASSWORD=REPLACE_WITH_A_DEMO_PASSWORD_10_TO_72_BYTES
DEMO_USER_PASSWORD=REPLACE_WITH_ANOTHER_DEMO_PASSWORD_10_TO_72_BYTES
