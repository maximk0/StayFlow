# Copy to .env (ignored). Replace every value before starting.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
INTERNAL_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
EUREKA_USERNAME=registry
EUREKA_PASSWORD=REPLACE_WITH_A_RANDOM_REGISTRY_PASSWORD
